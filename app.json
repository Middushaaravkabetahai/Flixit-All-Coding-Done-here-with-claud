{
  "expo": {
    "name": "Flixit",
    "slug": "flixit",
    "scheme": "flixit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "info.flixit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "info.flixit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#f3ede3",
    "description": "Scan your closet, get daily outfits from what you already own, and find the best price on what you buy next.",
    "primaryColor": "#18181b"
  }
}
