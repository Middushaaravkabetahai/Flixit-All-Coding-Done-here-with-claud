{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The tests import with explicit .ts extensions, which is what `node --test`
    // needs to run them straight from source with no build step.
    "allowImportingTsExtensions": true,
    "types": ["node", "react"]
  },
  "exclude": ["node_modules", "supabase/functions"]
}
